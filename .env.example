# ==============================================================================
# Pi Agent 通用多模型接入配置 (@mariozechner/pi-ai)
# 仅在服务端读取，不会暴露给前端浏览器
# ==============================================================================

# 1. 模型提供方（支持 @mariozechner/pi-ai 全部 30+ 内置提供方及自定义提供方）：
#    google | anthropic | openai | openrouter | xai | groq | mistral |
#    amazon-bedrock | google-vertex | azure-openai-responses | moonshotai |
#    moonshotai-cn | zai | minimax | fireworks | huggingface | ollama | custom
PI_AI_PROVIDER="google"

# 2. 模型 ID（不填且为 google 时默认使用 gemini-4-hydrogen）
#    示例：
#      google:      gemini-4-hydrogen
#      anthropic:   claude-sonnet-4-5
#      openai:      gpt-4o
#      openrouter:  anthropic/claude-sonnet-4
#      ollama:      qwen2.5vl:7b
#      dashscope:   qwen-vl-max
PI_AI_MODEL="gemini-4-hydrogen"

# 3. API 密钥：
#    - 方式 A：直接填写各提供方标准环境变量（@mariozechner/pi-ai 自动识别）：
#      GEMINI_API_KEY / OPENAI_API_KEY / ANTHROPIC_API_KEY / OPENROUTER_API_KEY /
#      XAI_API_KEY / MISTRAL_API_KEY / GROQ_API_KEY / ZAI_API_KEY / MOONSHOT_API_KEY
#    - 方式 B：或填写通用覆盖项 PI_AI_API_KEY（优先级最高；本地 Ollama 可留空）
GEMINI_API_KEY="MY_GEMINI_API_KEY"
PI_AI_API_KEY=""

# 4. 可选：自定义接口地址与协议（用于中转站、阿里云百炼、智谱、本地 Ollama / LM Studio / vLLM）
#    PI_AI_API 可选值：openai-completions | openai-responses | anthropic-messages | google-generative-ai
PI_AI_BASE_URL=""
PI_AI_API=""

# 运行环境配置
APP_URL="MY_APP_URL"
PORT="3000"
